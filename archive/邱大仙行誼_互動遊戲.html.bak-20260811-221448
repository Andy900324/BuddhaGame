const S={
  will:70, heart:10, prog:0,
  big:0, small:0, mercy:0, heaven:0,
  demon:0,           // 1 = 魔障狀態（修道心鎖定）
  hungerFixed:false, // 苦根是否已盡
  cur:"e1", ch:1, save:null, panRound:0,
  curseFail:0, curseDrain:0
};

function snapshot(){
  S.save={will:S.will,heart:S.heart,prog:S.prog,big:S.big,small:S.small,
          mercy:S.mercy,heaven:S.heaven,demon:S.demon,hungerFixed:S.hungerFixed,panRound:S.panRound};
}
function restore(){
  if(!S.save)return;
  Object.assign(S,S.save);
  S.save=JSON.parse(JSON.stringify(S.save));
}

const app=document.getElementById("app");
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));

/* =======================================================================
   HUD
   ======================================================================= */
function hud(){
  const willLow=S.will<30, heartLow=S.heart<=20;
  const hungerTxt = S.hungerFixed
      ? `苦根已盡`
      : `大餓 ${S.big}／72　小餓 ${S.small}`;
  return `
  <div id="hud">
    <div class="hud-top"><span>${CH[S.ch]?CH[S.ch].name:""}</span><span>邱處機　字啟發</span></div>
    <div class="bars">
      ${bar("意志力",S.will,"f-will",willLow)}
      ${bar("修道心",S.heart,"f-heart",heartLow)}
      ${bar("修行進度",S.prog,"f-prog",false)}
    </div>
    <div class="traits">
      <span class="trait">命苦之人</span>
      <span class="trait ${S.hungerFixed?'done':'hungry'}">${S.hungerFixed?'騰蛇鎖口・已改':'騰蛇鎖口'}　${hungerTxt}</span>
      ${S.demon?'<span class="trait" style="border-color:#a83232;color:#c94f4f">一念入魔・修道心鎖定</span>':''}
    </div>
  </div>`;
}
function bar(name,val,cls,danger){
  return `<div class="bar-row">
    <span class="bar-name">${name}</span>
    <span class="bar-track"><span class="bar-fill ${cls} ${danger?'danger':''}" style="width:${clamp(val,0,100)}%"></span></span>
    <span class="bar-val">${clamp(val,0,100)}%</span>
  </div>`;
}

/* =======================================================================
   數值結算
   ======================================================================= */
const LBL={will:"意志力",heart:"修道心",prog:"修行進度",big:"大餓",small:"小餓",mercy:"慈心"};

function applyDelta(d){
  const out=[];
  if(!d)return out;
  if(d.demon===-1){ S.demon=0; }   // 先解魔障，本回合的修道心才加得上去
  for(const k of ["will","heart","prog"]){
    if(d[k]===undefined)continue;
    if(k==="heart"&&S.demon&&d[k]>0)continue;   // 魔障期間修道心不增
    const before=S[k];
    S[k]=clamp(S[k]+d[k],0,100);
    const real=S[k]-before;
    if(real!==0)out.push({k,v:real});
    else if(d[k]!==0)out.push({k,v:d[k]});
  }
  if(d.big){ if(!S.hungerFixed){S.big+=d.big; out.push({k:"big",v:d.big});} }
  if(d.small){ S.small+=d.small; out.push({k:"small",v:d.small}); }
  if(d.mercy){ S.mercy+=d.mercy; out.push({k:"mercy",v:d.mercy}); }
  if(d.heaven){ S.heaven+=d.heaven; }
  if(d.demon===1){ S.demon=1; S.heart=10; }
  return out;
}
function deltaHTML(list){
  if(!list.length)return "";
  return `<div class="delta">${list.map(x=>{
    const up=x.v>0, isHunger=(x.k==="big"||x.k==="small");
    const cls=isHunger?"info":(up?"up":"down");
    return `<span class="d ${cls}">${LBL[x.k]} ${up?"+":""}${x.v}${(x.k==="big"||x.k==="small"||x.k==="mercy")?"":"%"}</span>`;
  }).join("")}</div>`;
}

// 飢餓事件 → 有機會堅定修道心
function hungerBonus(){
  if(S.demon)return "";
  if(Math.random()<0.5){
    const before=S.heart; S.heart=clamp(S.heart+5,0,100);
    if(S.heart>before)
      return `<div class="curse" style="border-color:var(--jade);background:rgba(91,140,123,.1);color:#8fc9b3">
        <b>飢餓中堅定了修道心</b>　餓到極處，反而想清楚一件事：這身皮囊要不到的，正是我要修的。<br>修道心 +${S.heart-before}%</div>`;
  }
  return "";
}

/* ===== 特性一：命苦之人　難度旋鈕 =====================================
   CURSE_TRIGGER：選對之後，觸發「壞情況」的機率
   CURSE_FATAL  ：壞情況之中，判定直接失敗的比例（其餘為扣 5% 意志力）
   目前 0.30 / 0.30 → 選對仍有 9% 判死、21% 扣意志力。
   全程選正解跑完 17 個事件的通關率約 20%（10000 局蒙地卡羅實測）。
   現場覺得太常重來，把 CURSE_FATAL 調成 0.15（通關率約 45%）
   或 CURSE_TRIGGER 調成 0.20（通關率約 40%）即可，其他都不用動。
   ==================================================================== */
const CURSE_TRIGGER = 0.30;
const CURSE_FATAL   = 0.30;

function curse(){
  if(Math.random()>=CURSE_TRIGGER) return {type:"none"};
  if(Math.random()<CURSE_FATAL)    return {type:"fail"};
  const before=S.will; S.will=clamp(S.will-5,0,100);
  return {type:"drain",amount:before-S.will};
}
function curseHTML(c){
  if(c.type==="drain")
    return `<div class="curse"><b>特性・命苦之人發作</b>　苦根重，路途不如意——即使選對了，也走得比別人辛苦。<br>意志力 −${c.amount}%</div>`;
  if(c.type==="fail")
    return `<div class="curse"><b>特性・命苦之人發作</b>　人生路途不如意、不順遂。這一次，連做對的事都出了岔子。</div>`;
  return "";
}

function checkFail(){
  if(S.will<20) return "意志力低於 20%，道心破裂，無法修行。";
  if(!S.demon && S.heart<=9) return "修道心已降至 10% 以下，從此對修行之路無興趣。";
  return null;
}

