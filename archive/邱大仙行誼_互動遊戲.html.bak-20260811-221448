function panChoose(i){
  const c=PAN_CHOICES[i];
  const list=applyDelta(c.d);

  // 隨機小事件
  const ev=PAN_EVENTS[Math.floor(Math.random()*PAN_EVENTS.length)];
  let evHTML="", evList=[];
  if(ev.special==="maiyi"){
    if(S.heart>=50){ evList=applyDelta({heart:+5});
      evHTML=`想起賽麻衣那句「應主餓死」，你心頭一動——<span class="em">那一個神仙餓得死？</span>`;
    }else{ evList=applyDelta({will:-10});
      evHTML=`想起賽麻衣那句「應主餓死」，心頭一沉。夜裡坐不安穩。`;
    }
  }else{
    evList=applyDelta(ev.d);
    evHTML=ev.t;
  }
  let bonus="";
  if((c.d&&c.d.big)||(ev.d&&(ev.d.big||ev.d.hungerRoll))) bonus=hungerBonus();

  const body=`
  <div class="card result">
    <div class="ch-label">蟠溪苦行・第 ${S.panRound} 段</div>
    <p style="color:var(--paper2);font-size:15px">${i+1}. ${c.t}</p>
    ${deltaHTML(list)}
    <div class="rule"></div>
    <div class="scene">${evHTML}</div>
    ${deltaHTML(evList)}
    ${bonus}
    ${S.big>=72&&!S.hungerFixed?`<div class="curse" style="border-color:var(--gold);background:rgba(201,162,39,.1);color:var(--gold2)">
      <b>大餓已滿七十二回</b>　小餓無數，不可勝計。這身餓死之相，磨到這裡，也磨得差不多了。</div>`:""}
  </div>`;

  const fail=checkFail();
  if(fail) return screenFail(fail,body);

  go(hud()+body+`<div class="center"><button class="btn" onclick="screenPan()">繼　續</button></div>`);
}

