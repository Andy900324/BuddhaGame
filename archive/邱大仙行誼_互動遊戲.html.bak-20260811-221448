function startGame(){
  S.will=70;S.heart=10;S.prog=0;S.big=0;S.small=0;S.mercy=0;S.heaven=0;
  S.demon=0;S.hungerFixed=false;S.ch=1;S.cur="e1";S.panRound=0;
  snapshot(); screenEvent();
}

/* ---------- 事件 ---------- */
function screenEvent(){
  const ev=EVENTS[S.cur];
  S.ch=ev.ch;
  go(hud()+`
  <div class="card">
    <div class="ch-label">${CH[ev.ch].name}</div>
    <h2>${ev.title}</h2>
    <div class="scene">${ev.scene}</div>
    <div class="ask">${ev.ask}</div>
    <div class="opts">
      ${ev.opts.map((o,i)=>`<button class="opt" onclick="choose(${i})"><span class="num">${i+1}.</span><span>${o.t}</span></button>`).join("")}
    </div>
  </div>`);
}

function choose(i){
  const ev=EVENTS[S.cur], o=ev.opts[i];
  let curseRes={type:"none"};
  if(o.kind==="ok") curseRes=curse();

  // 命苦之人：直接判定失敗
  if(curseRes.type==="fail"){
    return screenFail(`你選對了，但<span class="em">命苦之人</span>的苦根在這裡發作了。<br>人生路途不如意、不順遂——這一次，連做對的事都出了岔子。`,
      `<div class="curse"><b>特性・命苦之人</b>　選擇正確，仍觸發壞情況並判定失敗。</div>`);
  }

  const list=applyDelta(o.d);
  let bonus="";
  if(o.d && (o.d.hungerRoll||o.d.big)) bonus=hungerBonus();

  const vcls=o.kind==="ok"?"v-ok":(o.kind==="mid"?"v-mid":"v-bad");
  const vtxt=o.kind==="ok"?"○　可以走下去":(o.kind==="mid"?"△　走得下去，但付出了代價":"✕　模擬失敗");

  const body=`
  <div class="card result">
    <div class="ch-label">${ev.title}　你的選擇</div>
    <p style="color:var(--paper2);font-size:15px">${i+1}. ${o.t}</p>
    <div class="rule"></div>
    <div class="verdict ${vcls}">${vtxt}</div>
    <div class="scene">${o.res}</div>
    ${o.src?`<div class="src"><span class="tag">七真史傳・原文</span>${o.src}</div>`:""}
    ${deltaHTML(list)}
    ${curseHTML(curseRes)}
    ${bonus}
  </div>`;

  if(o.kind==="bad"){ return screenFail(null,body); }

  const fail=checkFail();
  if(fail){ return screenFail(fail,body); }

  go(hud()+body+`<div class="center"><button class="btn" onclick="next()">繼　續</button></div>`);
}

/* ---------- 流程推進 ---------- */
const ORDER=["e1","e2","e3","e4","e5","e6","e7","e8","e9","e10","e11","e12","e13","e14","e15","e16","e17"];

function next(){
  const idx=ORDER.indexOf(S.cur);
  const nxt=ORDER[idx+1];
  if(S.cur==="e17"){ S.panRound=0; return screenPan(); }
  S.cur=nxt;
  if(EVENTS[nxt].ch!==S.ch){ S.ch=EVENTS[nxt].ch; snapshot(); return screenChapter(); }
  screenEvent();
}

